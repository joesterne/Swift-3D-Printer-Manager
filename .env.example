# Variables the code actually reads. (The old example documented
# VITE_FIREBASE_* variables that nothing consumes — the Firebase config
# comes from firebase-applet-config.json — and a THINGIVERSE_TOKEN for a
# proxy endpoint that has been removed.)

# Gemini API Key (server-side only — AI calls go through /api/ai)
GEMINI_API_KEY=

# Optional: port for server.ts (defaults to 3000)
# PORT=3000
